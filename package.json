{
  "name": "liminal-prototype",
  "version": "0.1.0",
  "description": "Public interactive prototype for Liminal Agents \u2014 workflow demo with bounded refusal, deliberation, correction, and vault loops.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build:kernel": "bun build ../liminal-test/src/browser.ts --target=browser --format=esm --outfile=lib/osint-kernel.bundle.js",
    "tokens:sync": "node scripts/tokens/sync-upstream.mjs",
    "tokens:check": "node scripts/tokens/sync-upstream.mjs --check",
    "design:gen": "node scripts/design/gen-design-md.mjs",
    "design:check": "node scripts/design/gen-design-md.mjs --check",
    "design:publish": "node scripts/design/gen-design-md.mjs --siblings",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "canon:check": "node scripts/canon/lint-canon.mjs",
    "canon:report": "node scripts/canon/lint-canon.mjs --report",
    "canon:update": "node scripts/canon/lint-canon.mjs --update",
    "coherence:report": "node scripts/scenario-coherence.mjs",
    "coherence:check": "node scripts/scenario-coherence.mjs --check"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
